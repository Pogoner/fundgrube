# Vorlage; die Anwendung lädt diese Datei nicht automatisch.
# In GitHub: HUNTER_* / OPENAI_MODEL / EBAY_LEAF_CATEGORY_IDS als Variables,
# Zugangsdaten ausschließlich als Actions Secrets. Hier keine echten Schlüssel!

HUNTER_SOURCE=auto
# Erst nach Klärung öffentlicher Export- und Archivierungsrechte aktivieren.
# Ein späteres false entfernt keine Daten aus früheren öffentlichen Git-Commits.
HUNTER_PUBLISH_LIVE_DATA=false

# Optionale automatische KI-Vorsortierung; Modell muss ausdrücklich gesetzt sein.
HUNTER_LLM_ENABLED=false

# Production-Zugangsdaten: absichtlich leer.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_LEAF_CATEGORY_IDS=

# Nur für automatische KI-Aufrufe, nicht zum Lesen per ChatGPT-GitHub-Anbindung.
OPENAI_API_KEY=
OPENAI_MODEL=
