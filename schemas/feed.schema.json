{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pogoner.github.io/fundgrube/api/feed.schema.json",
  "title": "Fundgrube static snapshot documents",
  "description": "Read-only observations and uncertain personal-interest classifications, not a live feed, appraisal or transaction API.",
  "oneOf": [
    {"$ref": "#/$defs/dashboard"},
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/candidatePage"},
    {"$ref": "#/$defs/itemDocument"}
  ],
  "$defs": {
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableText": {"type": ["string", "null"]},
    "nullableTime": {"type": ["string", "null"], "format": "date-time"},
    "header": {
      "type": "object",
      "required": ["schema_version", "kind", "snapshot_id", "generated_at", "source_status", "untrusted_listing_text"],
      "properties": {
        "schema_version": {"const": 2},
        "kind": {"enum": ["feed", "manifest", "candidate-page", "item"]},
        "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "source_status": {"enum": ["unconfigured", "live", "partial", "error", "disabled", "demo"]},
        "untrusted_listing_text": {"const": true},
        "last_successful_scan_at": {"$ref": "#/$defs/nullableTime"},
        "status_message": {"type": "string"},
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "action": {"type": "string"}}
          }
        },
        "location": {"type": "object"},
        "criteria": {"type": "object"},
        "stats": {"type": "object"},
        "coverage": {"type": "object"},
        "ai_enabled": {"type": "boolean"},
        "ai_metadata": {"type": "object"},
        "freshness": {
          "type": "object",
          "required": ["maximum_source_age_hours", "evaluated_at", "recheck_at_read_time"],
          "properties": {
            "maximum_source_age_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 6},
            "evaluated_at": {"type": "string", "format": "date-time"},
            "recheck_at_read_time": {"const": true},
            "observation_is_not_condition_verification": {"const": true}
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id", "title", "description", "description_truncated", "description_status", "price_eur", "shipping_eur", "bid_count", "distance_km",
        "ends_at", "last_seen_at", "content_updated_at", "valid_until", "detail_path", "eligibility", "reserve_status",
        "score", "interest_score", "value_band", "assessment_confidence", "assessment_basis", "semantic_assessed", "reasons", "risks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "description": {"type": "string", "maxLength": 20000},
        "description_truncated": {"type": "boolean"},
        "description_status": {"enum": ["fresh", "stale", "unknown", "missing"]},
        "url": {"$ref": "#/$defs/nullableText"},
        "image": {"$ref": "#/$defs/nullableText"},
        "price_eur": {"$ref": "#/$defs/nullableNumber"},
        "shipping_eur": {"$ref": "#/$defs/nullableNumber"},
        "bid_count": {"type": ["integer", "null"], "minimum": 0},
        "ends_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "content_updated_at": {"$ref": "#/$defs/nullableTime"},
        "valid_until": {"type": "string", "format": "date-time"},
        "detail_path": {"type": "string", "pattern": "^api/items/[0-9a-f]{64}\\.json$"},
        "city": {"$ref": "#/$defs/nullableText"},
        "postcode": {"$ref": "#/$defs/nullableText"},
        "distance_km": {"$ref": "#/$defs/nullableNumber"},
        "condition": {"$ref": "#/$defs/nullableText"},
        "country": {"$ref": "#/$defs/nullableText"},
        "buying_options": {"type": "array", "items": {"type": "string"}},
        "eligibility": {"enum": ["eligible", "review", "excluded"]},
        "eligibility_reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "reserve_status": {"enum": ["none", "not_met", "met", "unknown"]},
        "reserve_price_met": {"type": ["boolean", "null"]},
        "local_pickup_confirmed": {"type": "boolean"},
        "pickup_radius_km": {"$ref": "#/$defs/nullableNumber"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "interest_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "value_band": {"enum": ["around_5", "around_50", "around_500", "unknown"]},
        "assessment_confidence": {"enum": ["low", "medium", "high"]},
        "assessment_basis": {"enum": ["heuristic", "llm"]},
        "semantic_assessed": {"type": "boolean"},
        "reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "risks": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "next_checks": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "value_reason": {"$ref": "#/$defs/nullableText"},
        "assessment_at": {"$ref": "#/$defs/nullableTime"},
        "semantic_assessed_at": {"$ref": "#/$defs/nullableTime"},
        "classification": {"$ref": "#/$defs/nullableText"},
        "product_kind": {"enum": ["apparatus", "tool", "accessory", "media", "consumable", "unknown"]},
        "semantic_interest": {"type": "integer", "minimum": 0, "maximum": 100},
        "price_kind": {"$ref": "#/$defs/nullableText"},
        "price_basis": {"$ref": "#/$defs/nullableText"},
        "minimum_bid_eur": {"$ref": "#/$defs/nullableNumber"},
        "total_eur": {"$ref": "#/$defs/nullableNumber"},
        "total_known_eur": {"$ref": "#/$defs/nullableNumber"},
        "currency": {"$ref": "#/$defs/nullableText"},
        "is_auction": {"type": ["boolean", "null"]},
        "shipping_confirmed": {"type": "boolean"},
        "detail_fetched": {"type": "boolean"},
        "details_fetched": {"type": "boolean"},
        "carried": {"type": "boolean"},
        "stale": {"type": "boolean"},
        "source": {"$ref": "#/$defs/nullableText"},
        "category_id": {"$ref": "#/$defs/nullableText"},
        "category_name": {"$ref": "#/$defs/nullableText"},
        "model": {"$ref": "#/$defs/nullableText"},
        "completeness": {"$ref": "#/$defs/nullableText"},
        "condition_claim": {"$ref": "#/$defs/nullableText"}
      }
    },
    "dashboard": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["deals"], "properties": {"kind": {"const": "feed"}, "deals": {"type": "array", "items": {"$ref": "#/$defs/item"}}}}
      ]
    },
    "manifest": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {
          "type": "object", "required": ["interface", "counts", "pages", "paths", "assessment"],
          "properties": {
            "kind": {"const": "manifest"},
            "interface": {
              "type": "object", "required": ["protocol", "read_only", "mcp_server", "repository", "branch", "site_url", "consistency"],
              "properties": {"protocol": {"const": "static-json"}, "read_only": {"const": true}, "mcp_server": {"const": false}, "repository": {"type": "string"}, "branch": {"type": "string"}, "site_url": {"type": "string", "format": "uri"}, "consistency": {"type": "string"}}
            },
            "counts": {"type": "object", "required": ["total", "pages", "page_size"], "properties": {"total": {"type": "integer", "minimum": 0}, "pages": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1, "maximum": 100}}},
            "pages": {
              "type": "array", "minItems": 1,
              "items": {"type": "object", "required": ["index", "path", "count", "sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "path": {"type": "string", "pattern": "^api/candidates/page-[0-9]{3,}\\.json$"}, "count": {"type": "integer", "minimum": 0, "maximum": 100}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
            },
            "paths": {"type": "object", "required": ["dashboard", "openapi", "schema", "guide"], "additionalProperties": {"type": "string"}},
            "assessment": {"type": "object", "required": ["purpose", "is_appraisal", "condition_verified", "must_recheck_original_before_bidding"], "properties": {"purpose": {"const": "personal_attention_priority"}, "is_appraisal": {"const": false}, "condition_verified": {"const": false}, "must_recheck_original_before_bidding": {"const": true}}}
          }
        }
      ]
    },
    "candidatePage": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["page_index", "page_count", "total", "items", "next_path"], "properties": {"kind": {"const": "candidate-page"}, "page_index": {"type": "integer", "minimum": 1}, "page_count": {"type": "integer", "minimum": 1}, "total": {"type": "integer", "minimum": 0}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "next_path": {"type": ["string", "null"], "pattern": "^api/candidates/page-[0-9]{3,}\\.json$"}}}
      ]
    },
    "itemDocument": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["item"], "properties": {"kind": {"const": "item"}, "item": {"$ref": "#/$defs/item"}}}
      ]
    }
  }
}
