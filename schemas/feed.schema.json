{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pogoner.github.io/fundgrube/api/feed.schema.json",
  "title": "Fundgrube static snapshot documents",
  "description": "V3 read-only observations retained at most until auction end; successful full AOG scans also reconcile missing listings. Separate strict remaining-time window and description TTL. Not a live feed, appraisal or transaction API. Score version 2 is independent.",
  "oneOf": [
    {"$ref": "#/$defs/dashboard"},
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/candidatePage"},
    {"$ref": "#/$defs/itemDocument"}
  ],
  "$defs": {
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableText": {"type": ["string", "null"]},
    "nullableTime": {"type": ["string", "null"], "format": "date-time"},
    "nullableScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "scoring": {
      "type": "object",
      "required": ["score_version", "formula", "rounding", "interest_score_is_derived", "additional_fact_bonus", "category_caps", "fields", "legacy_policy", "eligibility_is_separate", "is_appraisal", "condition_verified", "useability_is_condition_probability"],
      "properties": {
        "score_version": {"const": 2},
        "formula": {"const": "round_half_up(scalp_score * useability_score / 100)"},
        "rounding": {"const": "half_up"},
        "interest_score_is_derived": {"const": true},
        "additional_fact_bonus": {"const": 0},
        "category_caps": {"const": false},
        "fields": {
          "type": "object",
          "required": ["scalp_score", "useability_score", "interest_score", "semantic_interest"],
          "properties": {
            "scalp_score": {"type": "object", "required": ["label", "meaning", "reason_field"], "properties": {"label": {"const": "Scalp"}, "meaning": {"type": "string"}, "reason_field": {"const": "value_reason"}}},
            "useability_score": {"type": "object", "required": ["label", "meaning", "reason_field", "dependencies_field"], "properties": {"label": {"const": "Useability"}, "meaning": {"type": "string"}, "reason_field": {"const": "useability_reason"}, "dependencies_field": {"const": "dependencies"}}},
            "interest_score": {"type": "object", "required": ["label", "meaning", "alias"], "properties": {"label": {"const": "Interest"}, "meaning": {"type": "string"}, "alias": {"const": "score"}}},
            "semantic_interest": {"type": "object", "required": ["alias", "deprecated"], "properties": {"alias": {"const": "scalp_score"}, "deprecated": {"const": true}}}
          }
        },
        "legacy_policy": {"type": "string"},
        "eligibility_is_separate": {"const": true},
        "personal_interest_filter": {
          "type": "object",
          "properties": {
            "excluded_field": {"const": "personal_interest_excluded"},
            "reason_field": {"const": "personal_interest_reason"},
            "excludes_standalone_media": {"const": true},
            "changes_scores": {"const": false},
            "applies_to": {"type": "array", "items": {"enum": ["main", "top_scalp", "top_useability"]}}
          }
        },
        "is_appraisal": {"const": false},
        "condition_verified": {"const": false},
        "useability_is_condition_probability": {"const": false}
      }
    },
    "sourceProvider": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "sourceUrl": {"enum": ["https://auktionen-ohne-gebot.de/business-industrie/", null]},
    "verificationLevel": {"enum": ["aggregator", "direct_api", "user_supplied", "unknown", null]},
    "sourceTraversal": {
      "type": "object",
      "description": "A bounded walk through one changing aggregator search, not an atomic market snapshot.",
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"type": "string"},
        "traversal_completed": {"type": "boolean"},
        "started_at": {"$ref": "#/$defs/nullableTime"},
        "completed_at": {"$ref": "#/$defs/nullableTime"},
        "last_successful_traversal_at": {"$ref": "#/$defs/nullableTime"},
        "pages_fetched": {"type": "integer", "minimum": 0},
        "records_read": {"type": "integer", "minimum": 0},
        "unique_records": {"type": "integer", "minimum": 0},
        "duplicate_records": {"type": "integer", "minimum": 0},
        "empty_pages": {"type": "integer", "minimum": 0},
        "sparse_pages": {"type": "integer", "minimum": 0},
        "sparse_slots_estimate": {"type": "integer", "minimum": 0, "description": "Estimated unfilled reported positions, not a known count of missing unique auctions."},
        "absence_is_evidence": {"const": false, "description": "Missing IDs do not prove bids, auction end or lost pickup availability. Inventory reconciliation is a separate policy under coverage.reconciliation."},
        "reported_nonempty_but_no_records": {"type": "boolean", "description": "Positive reported totals but no records returned; offset completion is not a successful source refresh."},
        "total_reported_initial": {"type": ["integer", "null"], "minimum": 0},
        "total_reported_latest": {"type": ["integer", "null"], "minimum": 0},
        "total_reported_min": {"type": ["integer", "null"], "minimum": 0},
        "total_reported_max": {"type": ["integer", "null"], "minimum": 0},
        "total_changed": {"type": "boolean"},
        "next_offset": {"type": "integer", "minimum": 0},
        "remaining_reported": {"type": ["integer", "null"], "minimum": 0},
        "unobserved_estimate": {"type": ["integer", "null"], "minimum": 0},
        "short_pages": {"type": "integer", "minimum": 0},
        "repeated_pages": {"type": "integer", "minimum": 0},
        "stop_reason": {"type": ["string", "null"]}
      }
    },
    "sourceReconciliation": {
      "type": "object",
      "description": "Inventory reconciliation against the union of all enabled AOG searches after a successful complete scan; no claim about why a listing disappeared. Optional for older V3 snapshots.",
      "required": ["policy", "applied", "removed_records", "retained_newer_records", "reason"],
      "properties": {
        "policy": {"const": "successful_full_scan"},
        "applied": {"type": "boolean", "description": "Whether reconciliation ran, including successful scans with zero removals or genuinely empty results."},
        "removed_records": {"type": "integer", "minimum": 0, "description": "Previously retained listings removed because they were absent from the successful complete scan; excludes expiry and capacity pruning."},
        "retained_newer_records": {"type": "integer", "minimum": 0, "description": "Missing listings retained because their known observation is newer than the oldest page observation in the scan."},
        "reason": {"enum": ["completed", "incomplete_scan", "invalid_records", "invalid_observation"]}
      }
    },
    "header": {
      "type": "object",
      "required": ["schema_version", "kind", "snapshot_id", "generated_at", "source_status", "untrusted_listing_text", "freshness"],
      "properties": {
        "schema_version": {"const": 3},
        "kind": {"enum": ["feed", "manifest", "candidate-page", "item"]},
        "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "source_status": {"enum": ["unconfigured", "live", "partial", "error", "disabled", "demo"]},
        "source": {"$ref": "#/$defs/nullableText"},
        "provider": {"$ref": "#/$defs/nullableText"},
        "source_provider": {"$ref": "#/$defs/sourceProvider"},
        "source_url": {"$ref": "#/$defs/sourceUrl"},
        "source_observed_at": {"$ref": "#/$defs/nullableTime"},
        "verification_level": {"$ref": "#/$defs/verificationLevel"},
        "untrusted_listing_text": {"const": true},
        "last_successful_scan_at": {"$ref": "#/$defs/nullableTime"},
        "status_message": {"type": "string"},
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "action": {"type": "string"}}
          }
        },
        "location": {
          "type": "object",
          "description": "Public search context. New exports contain only country and pickup radius, never the private search postcode or city. Deprecated fields describe older snapshots only.",
          "properties": {
            "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
            "pickup_radius_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
            "postcode": {"$ref": "#/$defs/nullableText", "deprecated": true, "description": "Legacy private search origin; omitted from new exports."},
            "city": {"$ref": "#/$defs/nullableText", "deprecated": true, "description": "Legacy private search origin; omitted from new exports."}
          },
          "additionalProperties": false
        },
        "criteria": {"type": "object"},
        "stats": {"type": "object", "properties": {
          "personal_interest_excluded": {"type": "integer", "minimum": 0, "description": "Retained media listings excluded by the personal profile, independently of factual eligibility or scores."},
          "shortlisted": {"type": "integer", "minimum": 0, "description": "Items passing factual/time filters and the personal exclusion filter, before the adjustable Interest threshold."}
        }},
        "coverage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests_this_run": {"type": "integer", "minimum": 0},
            "api_requests_this_run": {"type": "integer", "minimum": 0},
            "max_api_requests_per_run": {"type": "integer", "minimum": 1, "maximum": 160},
            "max_run_seconds": {"type": "integer", "minimum": 30, "maximum": 1500},
            "elapsed_seconds": {"type": "integer", "minimum": 0},
            "requests_today": {"type": "integer", "minimum": 0},
            "daily_request_budget": {"type": "integer", "minimum": 1, "maximum": 8000},
            "records_read": {"type": "integer", "minimum": 0},
            "unique_records": {"type": "integer", "minimum": 0},
            "duplicate_records": {"type": "integer", "minimum": 0},
            "pages_fetched": {"type": "integer", "minimum": 0},
            "page_size": {"type": ["integer", "null"], "minimum": 1},
            "source_total_reported": {"type": ["integer", "null"], "minimum": 0},
            "source_cache_max_age_minutes": {"type": ["number", "null"], "minimum": 0},
            "source_claims_only": {"type": "boolean"},
            "traversal_completed": {"type": "boolean", "description": "All enabled aggregator searches visited offsets through their then-reported ends. Does not guarantee records for every position, stable pagination or all-eBay coverage."},
            "reported_nonempty_but_no_records": {"type": "boolean", "description": "At least one enabled search reported positive totals but returned no records; successful full-scan timestamps must not be renewed."},
            "scan_started_at": {"$ref": "#/$defs/nullableTime"},
            "scan_finished_at": {"$ref": "#/$defs/nullableTime"},
            "scan_completed_at": {"$ref": "#/$defs/nullableTime"},
            "last_successful_full_scan_at": {"$ref": "#/$defs/nullableTime"},
            "planned_interval_minutes": {"type": "number", "exclusiveMinimum": 0},
            "schedule_interval_minutes": {"type": "number", "exclusiveMinimum": 0},
            "pagination_is_stable": {"type": "boolean"},
            "searches": {"type": "object", "properties": {"general": {"$ref": "#/$defs/sourceTraversal"}, "pickup": {"$ref": "#/$defs/sourceTraversal"}}},
            "reconciliation": {"$ref": "#/$defs/sourceReconciliation"},
            "retention_capacity": {"type": "integer", "minimum": 1, "maximum": 5000, "description": "Effective maximum retained inventory size; not a promise of source coverage."},
            "next_offset": {"type": ["integer", "null"], "minimum": 0},
            "capped": {"type": "boolean"},
            "complete": {"type": "boolean"}
          }
        },
        "ai_enabled": {"type": "boolean"},
        "ai_metadata": {"type": "object"},
        "scoring": {"$ref": "#/$defs/scoring"},
        "interactive_review": {"type": "object", "properties": {
          "status": {"type": "string"}, "reviewer": {"const": "ChatGPT"},
          "reviewed_at": {"$ref": "#/$defs/nullableTime"},
          "oldest_reviewed_at": {"$ref": "#/$defs/nullableTime"},
          "latest_reviewed_at": {"$ref": "#/$defs/nullableTime"},
          "expires_at": {"$ref": "#/$defs/nullableTime", "description": "Null for content-bound persistent reviews; source facts have independent observation times."},
          "retention_basis": {"const": "content_and_auction"},
          "applied": {"type": "integer", "minimum": 0},
          "available": {"type": "integer", "minimum": 0},
          "unreviewed": {"type": "integer", "minimum": 0}
        }},
        "freshness": {
          "type": "object",
          "required": ["retention_basis", "maximum_source_age_hours", "active_window_hours", "source_warning_after_hours", "description_maximum_age_hours", "evaluated_at", "recheck_at_read_time"],
          "properties": {
            "retention_basis": {"const": "auction_end", "description": "Time-based upper retention limit; successful AOG reconciliation may remove missing listings earlier."},
            "maximum_source_age_hours": {"const": null, "description": "V3 does not expire candidate metadata by source age. Null is not zero and is not a promise of currentness."},
            "active_window_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 744, "description": "Active only when read-time now < ends_at < now + this window; default 72 hours, upper boundary excluded."},
            "source_warning_after_hours": {"const": 2, "description": "Observations older than this are visibly stale/carried, not removed by age alone."},
            "description_maximum_age_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 24, "description": "Independent description TTL; missing/future/too-old text timestamps remove the text, not candidate metadata."},
            "evaluated_at": {"type": "string", "format": "date-time"},
            "recheck_at_read_time": {"const": true},
            "observation_is_not_condition_verification": {"const": true},
            "retention_not_revalidation": {"const": true},
            "source_currentness_guaranteed": {"const": false},
            "direct_ebay_verification": {"type": "boolean"},
            "upstream_cache_age_is_provider_claim": {"type": "boolean"}
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id", "title", "description", "description_truncated", "description_status", "price_eur", "shipping_eur", "bid_count", "distance_km",
        "ends_at", "last_seen_at", "content_updated_at", "valid_until", "detail_path", "eligibility", "time_window_eligible", "reserve_status",
        "score", "interest_score", "value_band", "assessment_confidence", "assessment_basis", "semantic_assessed", "reasons", "risks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["score_version"], "properties": {"score_version": {"const": 1}}},
          "then": {
            "required": ["scalp_score", "useability_score", "useability_reason", "dependencies"],
            "properties": {"useability_score": {"const": null}, "interest_score": {"const": null}, "score": {"const": null}, "dependencies": {"maxItems": 0}}
          }
        },
        {
          "if": {"required": ["score_version"], "properties": {"score_version": {"const": 2}}},
          "then": {
            "required": ["scalp_score", "useability_score", "useability_reason", "dependencies"],
            "properties": {"interest_score": {"$ref": "#/$defs/nullableScore"}, "score": {"$ref": "#/$defs/nullableScore"}, "value_reason": {"type": ["string", "null"], "maxLength": 500}}
          }
        },
        {
          "if": {"required": ["score_version", "scalp_score"], "properties": {"score_version": {"const": 2}, "scalp_score": {"const": null}}},
          "then": {"properties": {"interest_score": {"const": null}, "score": {"const": null}}}
        },
        {
          "if": {"required": ["score_version", "useability_score"], "properties": {"score_version": {"const": 2}, "useability_score": {"const": null}}},
          "then": {"properties": {"interest_score": {"const": null}, "score": {"const": null}}}
        }
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "description": {"type": "string", "maxLength": 20000},
        "description_truncated": {"type": "boolean"},
        "description_status": {"enum": ["fresh", "stale", "unknown", "missing"]},
        "url": {"$ref": "#/$defs/nullableText"},
        "image": {"$ref": "#/$defs/nullableText"},
        "price_eur": {"$ref": "#/$defs/nullableNumber"},
        "shipping_eur": {"$ref": "#/$defs/nullableNumber"},
        "bid_count": {"type": ["integer", "null"], "minimum": 0},
        "ends_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "content_updated_at": {"$ref": "#/$defs/nullableTime"},
        "valid_until": {"type": "string", "format": "date-time", "description": "V3 equals ends_at; not a current-price/bid guarantee. Recheck auction end and active time window when reading."},
        "detail_path": {"type": "string", "pattern": "^api/items/[0-9a-f]{64}\\.json$"},
        "city": {"$ref": "#/$defs/nullableText"},
        "postcode": {"$ref": "#/$defs/nullableText"},
        "distance_km": {"$ref": "#/$defs/nullableNumber"},
        "condition": {"$ref": "#/$defs/nullableText"},
        "country": {"$ref": "#/$defs/nullableText"},
        "buying_options": {"type": "array", "items": {"type": "string"}},
        "eligibility": {"enum": ["eligible", "review", "excluded"]},
        "time_window_eligible": {"type": "boolean", "description": "Time-window membership at generation time only; recompute against the current clock."},
        "eligibility_without_time_window": {"enum": ["eligible", "review", "excluded", null], "description": "Optional backend-derived eligibility from all non-window facts. Combine with the current time window to allow later entry; missing/null must not overturn an exclusion by guessing from human-readable reasons."},
        "eligibility_reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "personal_interest_excluded": {"type": "boolean", "description": "Personal-profile exclusion applied to the main list and both Top-10 browsing lists. Independent of factual eligibility and semantic scores."},
        "personal_interest_reason": {"type": ["string", "null"], "maxLength": 500},
        "reserve_status": {"enum": ["none", "not_met", "met", "unknown"]},
        "reserve_price_met": {"type": ["boolean", "null"]},
        "local_pickup_confirmed": {"type": "boolean"},
        "pickup_available": {"type": ["boolean", "null"]},
        "pickup_search_confirmed": {"type": "boolean"},
        "pickup_search_profile_match": {"type": "boolean", "description": "Computed before redaction: valid aggregator pickup evidence matches the internal search postcode and does not exceed the configured radius. Not a verified seller location or current pickup agreement. When present, use this value instead of a legacy postcode comparison."},
        "pickup_search_postcode": {"type": "string", "pattern": "^[0-9]{5}$", "deprecated": true, "description": "Legacy private search origin; omitted from new exports. Use pickup_search_profile_match."},
        "pickup_search_radius_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
        "pickup_search_observed_at": {"type": "string", "format": "date-time", "description": "Independent observation time of the aggregator radius match; a later general-search refresh does not renew it."},
        "pickup_radius_km": {"$ref": "#/$defs/nullableNumber"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "interest_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_version": {"type": "integer", "enum": [1, 2], "description": "Per-item assessment version, independent of feed schema 3. Version 1 has no assessed Useability or new Interest."},
        "scalp_score": {"$ref": "#/$defs/nullableScore", "description": "Semantic economic-interest factor, not a price appraisal; version 1 preserves a known old overall score only as a legacy cue."},
        "useability_score": {"$ref": "#/$defs/nullableScore", "description": "Practical independence from additional equipment, software, accessories or infrastructure; not probability of working condition. Null means not assessed."},
        "useability_reason": {"type": "string", "maxLength": 500},
        "dependencies": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 240}, "description": "Untrusted assessment text listing practical dependencies; empty does not certify independence."},
        "value_band": {"enum": ["around_5", "around_50", "around_500", "unknown"]},
        "assessment_confidence": {"enum": ["low", "medium", "high"]},
        "assessment_basis": {"enum": ["heuristic", "llm"]},
        "semantic_assessed": {"type": "boolean"},
        "reasons": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "risks": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "next_checks": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 600}},
        "value_reason": {"$ref": "#/$defs/nullableText"},
        "assessment_at": {"$ref": "#/$defs/nullableTime"},
        "semantic_assessed_at": {"$ref": "#/$defs/nullableTime"},
        "semantic_review_mode": {"enum": ["interactive", "api"]},
        "classification": {"$ref": "#/$defs/nullableText"},
        "product_kind": {"enum": ["apparatus", "tool", "component", "accessory", "media", "consumable", "unknown"]},
        "semantic_interest": {"$ref": "#/$defs/nullableScore", "deprecated": true, "description": "Deprecated alias of exported scalp_score, never the derived V2 Interest."},
        "price_kind": {"$ref": "#/$defs/nullableText"},
        "price_basis": {"$ref": "#/$defs/nullableText"},
        "minimum_bid_eur": {"$ref": "#/$defs/nullableNumber"},
        "total_eur": {"$ref": "#/$defs/nullableNumber"},
        "total_known_eur": {"$ref": "#/$defs/nullableNumber"},
        "currency": {"$ref": "#/$defs/nullableText"},
        "is_auction": {"type": ["boolean", "null"]},
        "shipping_confirmed": {"type": "boolean"},
        "detail_fetched": {"type": "boolean"},
        "details_fetched": {"type": "boolean"},
        "carried": {"type": "boolean"},
        "stale": {"type": "boolean"},
        "source": {"$ref": "#/$defs/nullableText"},
        "source_provider": {"$ref": "#/$defs/sourceProvider"},
        "source_url": {"$ref": "#/$defs/sourceUrl"},
        "source_observed_at": {"$ref": "#/$defs/nullableTime"},
        "verification_level": {"$ref": "#/$defs/verificationLevel"},
        "category_id": {"$ref": "#/$defs/nullableText"},
        "category_name": {"$ref": "#/$defs/nullableText"},
        "model": {"$ref": "#/$defs/nullableText"},
        "completeness": {"$ref": "#/$defs/nullableText"},
        "condition_claim": {"$ref": "#/$defs/nullableText"}
      }
    },
    "dashboard": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["deals"], "properties": {"kind": {"const": "feed"}, "deals": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/item"}}}}
      ]
    },
    "manifest": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {
          "type": "object", "required": ["interface", "counts", "pages", "paths", "assessment"],
          "properties": {
            "kind": {"const": "manifest"},
            "interface": {
              "type": "object", "required": ["protocol", "read_only", "mcp_server", "repository", "branch", "site_url", "consistency"],
              "properties": {"protocol": {"const": "static-json"}, "read_only": {"const": true}, "mcp_server": {"const": false}, "repository": {"type": "string"}, "branch": {"type": "string"}, "site_url": {"type": "string", "format": "uri"}, "consistency": {"type": "string"}}
            },
            "counts": {"type": "object", "required": ["total", "pages", "page_size"], "properties": {"total": {"type": "integer", "minimum": 0, "maximum": 5000}, "pages": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1, "maximum": 100}}},
            "pages": {
              "type": "array", "minItems": 1,
              "items": {"type": "object", "required": ["index", "path", "count", "sha256"], "properties": {"index": {"type": "integer", "minimum": 1}, "path": {"type": "string", "pattern": "^api/candidates/page-[0-9]{3,}\\.json$"}, "count": {"type": "integer", "minimum": 0, "maximum": 100}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
            },
            "paths": {"type": "object", "required": ["dashboard", "openapi", "schema", "guide"], "additionalProperties": {"type": "string"}},
            "assessment": {"type": "object", "required": ["purpose", "is_appraisal", "condition_verified", "must_recheck_original_before_bidding"], "properties": {"purpose": {"const": "personal_attention_priority"}, "score_version": {"const": 2}, "interest_formula": {"const": "round_half_up(scalp_score * useability_score / 100)"}, "useability_focus": {"const": "dependencies_and_practical_independence"}, "useability_is_condition_probability": {"const": false}, "is_appraisal": {"const": false}, "condition_verified": {"const": false}, "must_recheck_original_before_bidding": {"const": true}}}
          }
        }
      ]
    },
    "candidatePage": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["page_index", "page_count", "total", "items", "next_path"], "properties": {"kind": {"const": "candidate-page"}, "page_index": {"type": "integer", "minimum": 1}, "page_count": {"type": "integer", "minimum": 1}, "total": {"type": "integer", "minimum": 0}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "next_path": {"type": ["string", "null"], "pattern": "^api/candidates/page-[0-9]{3,}\\.json$"}}}
      ]
    },
    "itemDocument": {
