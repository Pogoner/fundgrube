{
  "components": {
    "schemas": {
      "candidatePage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/header"
          },
          {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/components/schemas/item"
                },
                "maxItems": 100,
                "type": "array"
              },
              "kind": {
                "const": "candidate-page"
              },
              "next_path": {
                "pattern": "^api/candidates/page-[0-9]{3,}\\.json$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "page_count": {
                "minimum": 1,
                "type": "integer"
              },
              "page_index": {
                "minimum": 1,
                "type": "integer"
              },
              "total": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "page_index",
              "page_count",
              "total",
              "items",
              "next_path"
            ],
            "type": "object"
          }
        ]
      },
      "dashboard": {
        "allOf": [
          {
            "$ref": "#/components/schemas/header"
          },
          {
            "properties": {
              "deals": {
                "items": {
                  "$ref": "#/components/schemas/item"
                },
                "maxItems": 800,
                "type": "array"
              },
              "kind": {
                "const": "feed"
              }
            },
            "required": [
              "deals"
            ],
            "type": "object"
          }
        ]
      },
      "header": {
        "properties": {
          "ai_enabled": {
            "type": "boolean"
          },
          "ai_metadata": {
            "type": "object"
          },
          "blockers": {
            "items": {
              "properties": {
                "action": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "coverage": {
            "additionalProperties": true,
            "properties": {
              "capped": {
                "type": "boolean"
              },
              "complete": {
                "type": "boolean"
              },
              "next_offset": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "page_size": {
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "pages_fetched": {
                "minimum": 0,
                "type": "integer"
              },
              "requests_this_run": {
                "minimum": 0,
                "type": "integer"
              },
              "source_cache_max_age_minutes": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "source_claims_only": {
                "type": "boolean"
              },
              "source_total_reported": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "criteria": {
            "type": "object"
          },
          "freshness": {
            "properties": {
              "active_window_hours": {
                "description": "Active only when read-time now < ends_at < now + this window; default 72 hours, upper boundary excluded.",
                "exclusiveMinimum": 0,
                "maximum": 744,
                "type": "number"
              },
              "description_maximum_age_hours": {
                "description": "Independent description TTL; missing/future/too-old text timestamps remove the text, not candidate metadata.",
                "exclusiveMinimum": 0,
                "maximum": 24,
                "type": "number"
              },
              "direct_ebay_verification": {
                "type": "boolean"
              },
              "evaluated_at": {
                "format": "date-time",
                "type": "string"
              },
              "maximum_source_age_hours": {
                "const": null,
                "description": "V3 does not expire candidate metadata by source age. Null is not zero and is not a promise of currentness."
              },
              "observation_is_not_condition_verification": {
                "const": true
              },
              "recheck_at_read_time": {
                "const": true
              },
              "retention_basis": {
                "const": "auction_end"
              },
              "retention_not_revalidation": {
                "const": true
              },
              "source_currentness_guaranteed": {
                "const": false
              },
              "source_warning_after_hours": {
                "const": 2,
                "description": "Observations older than this are visibly stale/carried, not removed by age alone."
              },
              "upstream_cache_age_is_provider_claim": {
                "type": "boolean"
              }
            },
            "required": [
              "retention_basis",
              "maximum_source_age_hours",
              "active_window_hours",
              "source_warning_after_hours",
              "description_maximum_age_hours",
              "evaluated_at",
              "recheck_at_read_time"
            ],
            "type": "object"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "interactive_review": {
            "properties": {
              "applied": {
                "minimum": 0,
                "type": "integer"
              },
              "available": {
                "minimum": 0,
                "type": "integer"
              },
              "reviewed_at": {
                "$ref": "#/components/schemas/nullableTime"
              },
              "reviewer": {
                "const": "ChatGPT"
              },
              "status": {
                "type": "string"
              },
              "unreviewed": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "kind": {
            "enum": [
              "feed",
              "manifest",
              "candidate-page",
              "item"
            ]
          },
          "last_successful_scan_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "location": {
            "type": "object"
          },
          "provider": {
            "$ref": "#/components/schemas/nullableText"
          },
          "schema_version": {
            "const": 3
          },
          "scoring": {
            "$ref": "#/components/schemas/scoring"
          },
          "snapshot_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/nullableText"
          },
          "source_observed_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "source_provider": {
            "$ref": "#/components/schemas/sourceProvider"
          },
          "source_status": {
            "enum": [
              "unconfigured",
              "live",
              "partial",
              "error",
              "disabled",
              "demo"
            ]
          },
          "source_url": {
            "$ref": "#/components/schemas/sourceUrl"
          },
          "stats": {
            "type": "object"
          },
          "status_message": {
            "type": "string"
          },
          "untrusted_listing_text": {
            "const": true
          },
          "verification_level": {
            "$ref": "#/components/schemas/verificationLevel"
          }
        },
        "required": [
          "schema_version",
          "kind",
          "snapshot_id",
          "generated_at",
          "source_status",
          "untrusted_listing_text",
          "freshness"
        ],
        "type": "object"
      },
      "item": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "score_version": {
                  "const": 1
                }
              },
              "required": [
                "score_version"
              ]
            },
            "then": {
              "properties": {
                "dependencies": {
                  "maxItems": 0
                },
                "interest_score": {
                  "const": null
                },
                "score": {
                  "const": null
                },
                "useability_score": {
                  "const": null
                }
              },
              "required": [
                "scalp_score",
                "useability_score",
                "useability_reason",
                "dependencies"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "score_version": {
                  "const": 2
                }
              },
              "required": [
                "score_version"
              ]
            },
            "then": {
              "properties": {
                "interest_score": {
                  "$ref": "#/components/schemas/nullableScore"
                },
                "score": {
                  "$ref": "#/components/schemas/nullableScore"
                },
                "value_reason": {
                  "maxLength": 500,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "scalp_score",
                "useability_score",
                "useability_reason",
                "dependencies"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "scalp_score": {
                  "const": null
                },
                "score_version": {
                  "const": 2
                }
              },
              "required": [
                "score_version",
                "scalp_score"
              ]
            },
            "then": {
              "properties": {
                "interest_score": {
                  "const": null
                },
                "score": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "score_version": {
                  "const": 2
                },
                "useability_score": {
                  "const": null
                }
              },
              "required": [
                "score_version",
                "useability_score"
              ]
            },
            "then": {
              "properties": {
                "interest_score": {
                  "const": null
                },
                "score": {
                  "const": null
                }
              }
            }
          }
        ],
        "properties": {
          "assessment_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "assessment_basis": {
            "enum": [
              "heuristic",
              "llm"
            ]
          },
          "assessment_confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "bid_count": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "buying_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "carried": {
            "type": "boolean"
          },
          "category_id": {
            "$ref": "#/components/schemas/nullableText"
          },
          "category_name": {
            "$ref": "#/components/schemas/nullableText"
          },
          "city": {
            "$ref": "#/components/schemas/nullableText"
          },
          "classification": {
            "$ref": "#/components/schemas/nullableText"
          },
          "completeness": {
            "$ref": "#/components/schemas/nullableText"
          },
          "condition": {
            "$ref": "#/components/schemas/nullableText"
          },
          "condition_claim": {
            "$ref": "#/components/schemas/nullableText"
          },
          "content_updated_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "country": {
            "$ref": "#/components/schemas/nullableText"
          },
          "currency": {
            "$ref": "#/components/schemas/nullableText"
          },
          "dependencies": {
            "description": "Untrusted assessment text listing practical dependencies; empty does not certify independence.",
            "items": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "description": {
            "maxLength": 20000,
            "type": "string"
          },
          "description_status": {
            "enum": [
              "fresh",
              "stale",
              "unknown",
              "missing"
            ]
          },
          "description_truncated": {
            "type": "boolean"
          },
          "detail_fetched": {
            "type": "boolean"
          },
          "detail_path": {
            "pattern": "^api/items/[0-9a-f]{64}\\.json$",
            "type": "string"
          },
          "details_fetched": {
            "type": "boolean"
          },
          "distance_km": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "eligibility": {
            "enum": [
              "eligible",
              "review",
              "excluded"
            ]
          },
          "eligibility_reasons": {
            "items": {
              "maxLength": 600,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "eligibility_without_time_window": {
            "description": "Optional backend-derived eligibility from all non-window facts. Combine with the current time window to allow later entry; missing/null must not overturn an exclusion by guessing from human-readable reasons.",
            "enum": [
              "eligible",
              "review",
              "excluded",
              null
            ]
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/nullableText"
          },
          "interest_score": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "is_auction": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "last_seen_at": {
            "format": "date-time",
            "type": "string"
          },
          "local_pickup_confirmed": {
            "type": "boolean"
          },
          "minimum_bid_eur": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "model": {
            "$ref": "#/components/schemas/nullableText"
          },
          "next_checks": {
            "items": {
              "maxLength": 600,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "pickup_available": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "pickup_radius_km": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "pickup_search_confirmed": {
            "type": "boolean"
          },
          "pickup_search_postcode": {
            "pattern": "^[0-9]{5}$",
            "type": "string"
          },
          "pickup_search_radius_km": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "postcode": {
            "$ref": "#/components/schemas/nullableText"
          },
          "price_basis": {
            "$ref": "#/components/schemas/nullableText"
          },
          "price_eur": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "price_kind": {
            "$ref": "#/components/schemas/nullableText"
          },
          "product_kind": {
            "enum": [
              "apparatus",
              "tool",
              "component",
              "accessory",
              "media",
              "consumable",
              "unknown"
            ]
          },
          "reasons": {
            "items": {
              "maxLength": 600,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "reserve_price_met": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "reserve_status": {
            "enum": [
              "none",
              "not_met",
              "met",
              "unknown"
            ]
          },
          "risks": {
            "items": {
              "maxLength": 600,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "scalp_score": {
            "$ref": "#/components/schemas/nullableScore",
            "description": "Semantic economic-interest factor, not a price appraisal; version 1 preserves a known old overall score only as a legacy cue."
          },
          "score": {
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "score_version": {
            "description": "Per-item assessment version, independent of feed schema 3. Version 1 has no assessed Useability or new Interest.",
            "enum": [
              1,
              2
            ],
            "type": "integer"
          },
          "semantic_assessed": {
            "type": "boolean"
          },
          "semantic_assessed_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "semantic_interest": {
            "$ref": "#/components/schemas/nullableScore",
            "deprecated": true,
            "description": "Deprecated alias of exported scalp_score, never the derived V2 Interest."
          },
          "semantic_review_mode": {
            "enum": [
              "interactive",
              "api"
            ]
          },
          "shipping_confirmed": {
            "type": "boolean"
          },
          "shipping_eur": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "source": {
            "$ref": "#/components/schemas/nullableText"
          },
          "source_observed_at": {
            "$ref": "#/components/schemas/nullableTime"
          },
          "source_provider": {
            "$ref": "#/components/schemas/sourceProvider"
          },
          "source_url": {
            "$ref": "#/components/schemas/sourceUrl"
          },
          "stale": {
            "type": "boolean"
          },
          "time_window_eligible": {
            "description": "Time-window membership at generation time only; recompute against the current clock.",
            "type": "boolean"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "total_eur": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "total_known_eur": {
            "$ref": "#/components/schemas/nullableNumber"
          },
          "url": {
            "$ref": "#/components/schemas/nullableText"
          },
          "useability_reason": {
            "maxLength": 500,
            "type": "string"
          },
          "useability_score": {
            "$ref": "#/components/schemas/nullableScore",
            "description": "Practical independence from additional equipment, software, accessories or infrastructure; not probability of working condition. Null means not assessed."
          },
          "valid_until": {
            "description": "V3 equals ends_at; not a current-price/bid guarantee. Recheck auction end and active time window when reading.",
            "format": "date-time",
            "type": "string"
          },
          "value_band": {
            "enum": [
              "around_5",
              "around_50",
              "around_500",
              "unknown"
            ]
          },
          "value_reason": {
            "$ref": "#/components/schemas/nullableText"
          },
          "verification_level": {
            "$ref": "#/components/schemas/verificationLevel"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "description_truncated",
          "description_status",
          "price_eur",
          "shipping_eur",
          "bid_count",
          "distance_km",
          "ends_at",
          "last_seen_at",
          "content_updated_at",
          "valid_until",
          "detail_path",
          "eligibility",
          "time_window_eligible",
          "reserve_status",
          "score",
          "interest_score",
          "value_band",
          "assessment_confidence",
          "assessment_basis",
          "semantic_assessed",
          "reasons",
          "risks"
        ],
        "type": "object"
      },
      "itemDocument": {
        "allOf": [
          {
            "$ref": "#/components/schemas/header"
          },
          {
            "properties": {
              "item": {
                "$ref": "#/components/schemas/item"
              },
              "kind": {
                "const": "item"
              }
            },
            "required": [
              "item"
            ],
            "type": "object"
          }
        ]
      },
      "manifest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/header"
          },
          {
            "properties": {
              "assessment": {
                "properties": {
                  "condition_verified": {
                    "const": false
                  },
                  "interest_formula": {
                    "const": "round_half_up(scalp_score * useability_score / 100)"
                  },
                  "is_appraisal": {
                    "const": false
                  },
                  "must_recheck_original_before_bidding": {
                    "const": true
                  },
                  "purpose": {
                    "const": "personal_attention_priority"
                  },
                  "score_version": {
                    "const": 2
                  },
                  "useability_focus": {
                    "const": "dependencies_and_practical_independence"
                  },
                  "useability_is_condition_probability": {
                    "const": false
                  }
                },
                "required": [
                  "purpose",
                  "is_appraisal",
                  "condition_verified",
                  "must_recheck_original_before_bidding"
                ],
                "type": "object"
              },
              "counts": {
                "properties": {
                  "page_size": {
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "pages": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "total": {
                    "maximum": 800,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "total",
                  "pages",
                  "page_size"
                ],
                "type": "object"
              },
              "interface": {
                "properties": {
                  "branch": {
                    "type": "string"
                  },
                  "consistency": {
                    "type": "string"
                  },
                  "mcp_server": {
                    "const": false
                  },
                  "protocol": {
                    "const": "static-json"
                  },
                  "read_only": {
                    "const": true
                  },
                  "repository": {
                    "type": "string"
                  },
                  "site_url": {
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "protocol",
                  "read_only",
                  "mcp_server",
                  "repository",
                  "branch",
                  "site_url",
                  "consistency"
                ],
                "type": "object"
              },
              "kind": {
                "const": "manifest"
              },
              "pages": {
                "items": {
                  "properties": {
                    "count": {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "index": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "path": {
                      "pattern": "^api/candidates/page-[0-9]{3,}\\.json$",
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "index",
                    "path",
                    "count",
                    "sha256"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "paths": {
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "dashboard",
                  "openapi",
                  "schema",
                  "guide"
                ],
                "type": "object"
              }
            },
            "required": [
              "interface",
              "counts",
              "pages",
              "paths",
              "assessment"
            ],
            "type": "object"
          }
        ]
      },
      "nullableNumber": {
        "minimum": 0,
        "type": [
          "number",
          "null"
        ]
      },
      "nullableScore": {
        "maximum": 100,
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "nullableText": {
        "type": [
          "string",
          "null"
        ]
      },
      "nullableTime": {
        "format": "date-time",
        "type": [
          "string",
          "null"
        ]
      },
      "scoring": {
        "properties": {
          "additional_fact_bonus": {
            "const": 0
          },
          "category_caps": {
            "const": false
          },
          "condition_verified": {
            "const": false
          },
          "eligibility_is_separate": {
            "const": true
          },
          "fields": {
            "properties": {
              "interest_score": {
                "properties": {
                  "alias": {
                    "const": "score"
                  },
                  "label": {
                    "const": "Interest"
                  },
                  "meaning": {
                    "type": "string"
                  }
                },
                "required": [
