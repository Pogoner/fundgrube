{
  "$defs": {
    "candidatePage": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/item"
              },
              "maxItems": 100,
              "type": "array"
            },
            "kind": {
              "const": "candidate-page"
            },
            "next_path": {
              "pattern": "^api/candidates/page-[0-9]{3,}\\.json$",
              "type": [
                "string",
                "null"
              ]
            },
            "page_count": {
              "minimum": 1,
              "type": "integer"
            },
            "page_index": {
              "minimum": 1,
              "type": "integer"
            },
            "total": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "page_index",
            "page_count",
            "total",
            "items",
            "next_path"
          ],
          "type": "object"
        }
      ]
    },
    "dashboard": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "properties": {
            "deals": {
              "items": {
                "$ref": "#/$defs/item"
              },
              "maxItems": 5000,
              "type": "array"
            },
            "kind": {
              "const": "feed"
            }
          },
          "required": [
            "deals"
          ],
          "type": "object"
        }
      ]
    },
    "header": {
      "properties": {
        "ai_enabled": {
          "type": "boolean"
        },
        "ai_metadata": {
          "type": "object"
        },
        "blockers": {
          "items": {
            "properties": {
              "action": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "coverage": {
          "additionalProperties": true,
          "properties": {
            "api_requests_this_run": {
              "minimum": 0,
              "type": "integer"
            },
            "capped": {
              "type": "boolean"
            },
            "complete": {
              "type": "boolean"
            },
            "daily_request_budget": {
              "maximum": 8000,
              "minimum": 1,
              "type": "integer"
            },
            "duplicate_records": {
              "minimum": 0,
              "type": "integer"
            },
            "elapsed_seconds": {
              "minimum": 0,
              "type": "integer"
            },
            "last_successful_full_scan_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "max_api_requests_per_run": {
              "maximum": 160,
              "minimum": 1,
              "type": "integer"
            },
            "max_run_seconds": {
              "maximum": 1500,
              "minimum": 30,
              "type": "integer"
            },
            "next_offset": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "page_size": {
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "pages_fetched": {
              "minimum": 0,
              "type": "integer"
            },
            "pagination_is_stable": {
              "type": "boolean"
            },
            "planned_interval_minutes": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "records_read": {
              "minimum": 0,
              "type": "integer"
            },
            "requests_this_run": {
              "minimum": 0,
              "type": "integer"
            },
            "requests_today": {
              "minimum": 0,
              "type": "integer"
            },
            "retention_capacity": {
              "description": "Effective maximum retained inventory size; not a promise of source coverage.",
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            "scan_completed_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "scan_finished_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "scan_started_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "schedule_interval_minutes": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "searches": {
              "properties": {
                "general": {
                  "$ref": "#/$defs/sourceTraversal"
                },
                "pickup": {
                  "$ref": "#/$defs/sourceTraversal"
                }
              },
              "type": "object"
            },
            "source_cache_max_age_minutes": {
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "source_claims_only": {
              "type": "boolean"
            },
            "source_total_reported": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "traversal_completed": {
              "description": "All enabled aggregator searches reached their then-reported ends in this run. Does not guarantee stable pagination or all-eBay coverage.",
              "type": "boolean"
            },
            "unique_records": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "criteria": {
          "type": "object"
        },
        "freshness": {
          "properties": {
            "active_window_hours": {
              "description": "Active only when read-time now < ends_at < now + this window; default 72 hours, upper boundary excluded.",
              "exclusiveMinimum": 0,
              "maximum": 744,
              "type": "number"
            },
            "description_maximum_age_hours": {
              "description": "Independent description TTL; missing/future/too-old text timestamps remove the text, not candidate metadata.",
              "exclusiveMinimum": 0,
              "maximum": 24,
              "type": "number"
            },
            "direct_ebay_verification": {
              "type": "boolean"
            },
            "evaluated_at": {
              "format": "date-time",
              "type": "string"
            },
            "maximum_source_age_hours": {
              "const": null,
              "description": "V3 does not expire candidate metadata by source age. Null is not zero and is not a promise of currentness."
            },
            "observation_is_not_condition_verification": {
              "const": true
            },
            "recheck_at_read_time": {
              "const": true
            },
            "retention_basis": {
              "const": "auction_end"
            },
            "retention_not_revalidation": {
              "const": true
            },
            "source_currentness_guaranteed": {
              "const": false
            },
            "source_warning_after_hours": {
              "const": 2,
              "description": "Observations older than this are visibly stale/carried, not removed by age alone."
            },
            "upstream_cache_age_is_provider_claim": {
              "type": "boolean"
            }
          },
          "required": [
            "retention_basis",
            "maximum_source_age_hours",
            "active_window_hours",
            "source_warning_after_hours",
            "description_maximum_age_hours",
            "evaluated_at",
            "recheck_at_read_time"
          ],
          "type": "object"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "interactive_review": {
          "properties": {
            "applied": {
              "minimum": 0,
              "type": "integer"
            },
            "available": {
              "minimum": 0,
              "type": "integer"
            },
            "expires_at": {
              "$ref": "#/$defs/nullableTime",
              "description": "Null for content-bound persistent reviews; source facts have independent observation times."
            },
            "latest_reviewed_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "oldest_reviewed_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "retention_basis": {
              "const": "content_and_auction"
            },
            "reviewed_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "reviewer": {
              "const": "ChatGPT"
            },
            "status": {
              "type": "string"
            },
            "unreviewed": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "kind": {
          "enum": [
            "feed",
            "manifest",
            "candidate-page",
            "item"
          ]
        },
        "last_successful_scan_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "location": {
          "type": "object"
        },
        "provider": {
          "$ref": "#/$defs/nullableText"
        },
        "schema_version": {
          "const": 3
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "snapshot_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/nullableText"
        },
        "source_observed_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "source_provider": {
          "$ref": "#/$defs/sourceProvider"
        },
        "source_status": {
          "enum": [
            "unconfigured",
            "live",
            "partial",
            "error",
            "disabled",
            "demo"
          ]
        },
        "source_url": {
          "$ref": "#/$defs/sourceUrl"
        },
        "stats": {
          "properties": {
            "personal_interest_excluded": {
              "description": "Retained media listings excluded by the personal profile, independently of factual eligibility or scores.",
              "minimum": 0,
              "type": "integer"
            },
            "shortlisted": {
              "description": "Items passing factual/time filters and the personal exclusion filter, before the adjustable Interest threshold.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "status_message": {
          "type": "string"
        },
        "untrusted_listing_text": {
          "const": true
        },
        "verification_level": {
          "$ref": "#/$defs/verificationLevel"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "snapshot_id",
        "generated_at",
        "source_status",
        "untrusted_listing_text",
        "freshness"
      ],
      "type": "object"
    },
    "item": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "score_version": {
                "const": 1
              }
            },
            "required": [
              "score_version"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "maxItems": 0
              },
              "interest_score": {
                "const": null
              },
              "score": {
                "const": null
              },
              "useability_score": {
                "const": null
              }
            },
            "required": [
              "scalp_score",
              "useability_score",
              "useability_reason",
              "dependencies"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "score_version": {
                "const": 2
              }
            },
            "required": [
              "score_version"
            ]
          },
          "then": {
            "properties": {
              "interest_score": {
                "$ref": "#/$defs/nullableScore"
              },
              "score": {
                "$ref": "#/$defs/nullableScore"
              },
              "value_reason": {
                "maxLength": 500,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "scalp_score",
              "useability_score",
              "useability_reason",
              "dependencies"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scalp_score": {
                "const": null
              },
              "score_version": {
                "const": 2
              }
            },
            "required": [
              "score_version",
              "scalp_score"
            ]
          },
          "then": {
            "properties": {
              "interest_score": {
                "const": null
              },
              "score": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_version": {
                "const": 2
              },
              "useability_score": {
                "const": null
              }
            },
            "required": [
              "score_version",
              "useability_score"
            ]
          },
          "then": {
            "properties": {
              "interest_score": {
                "const": null
              },
              "score": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "assessment_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "assessment_basis": {
          "enum": [
            "heuristic",
            "llm"
          ]
        },
        "assessment_confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "bid_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "buying_options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "carried": {
          "type": "boolean"
        },
        "category_id": {
          "$ref": "#/$defs/nullableText"
        },
        "category_name": {
          "$ref": "#/$defs/nullableText"
        },
        "city": {
          "$ref": "#/$defs/nullableText"
        },
        "classification": {
          "$ref": "#/$defs/nullableText"
        },
        "completeness": {
          "$ref": "#/$defs/nullableText"
        },
        "condition": {
          "$ref": "#/$defs/nullableText"
        },
        "condition_claim": {
          "$ref": "#/$defs/nullableText"
        },
        "content_updated_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "country": {
          "$ref": "#/$defs/nullableText"
        },
        "currency": {
          "$ref": "#/$defs/nullableText"
        },
        "dependencies": {
          "description": "Untrusted assessment text listing practical dependencies; empty does not certify independence.",
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "type": "array"
        },
        "description": {
          "maxLength": 20000,
          "type": "string"
        },
        "description_status": {
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "missing"
          ]
        },
        "description_truncated": {
          "type": "boolean"
        },
        "detail_fetched": {
          "type": "boolean"
        },
        "detail_path": {
          "pattern": "^api/items/[0-9a-f]{64}\\.json$",
          "type": "string"
        },
        "details_fetched": {
          "type": "boolean"
        },
        "distance_km": {
          "$ref": "#/$defs/nullableNumber"
        },
        "eligibility": {
          "enum": [
            "eligible",
            "review",
            "excluded"
          ]
        },
        "eligibility_reasons": {
          "items": {
            "maxLength": 600,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "eligibility_without_time_window": {
          "description": "Optional backend-derived eligibility from all non-window facts. Combine with the current time window to allow later entry; missing/null must not overturn an exclusion by guessing from human-readable reasons.",
          "enum": [
            "eligible",
            "review",
            "excluded",
            null
          ]
        },
        "ends_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/nullableText"
        },
        "interest_score": {
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "is_auction": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "last_seen_at": {
          "format": "date-time",
          "type": "string"
        },
        "local_pickup_confirmed": {
          "type": "boolean"
        },
        "minimum_bid_eur": {
          "$ref": "#/$defs/nullableNumber"
        },
        "model": {
          "$ref": "#/$defs/nullableText"
        },
        "next_checks": {
          "items": {
            "maxLength": 600,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "personal_interest_excluded": {
          "description": "Personal-profile exclusion applied to the main list and both Top-10 browsing lists. Independent of factual eligibility and semantic scores.",
          "type": "boolean"
        },
        "personal_interest_reason": {
          "maxLength": 500,
          "type": [
            "string",
            "null"
          ]
        },
        "pickup_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pickup_radius_km": {
          "$ref": "#/$defs/nullableNumber"
        },
        "pickup_search_confirmed": {
          "type": "boolean"
        },
        "pickup_search_observed_at": {
          "description": "Independent observation time of the aggregator radius match; a later general-search refresh does not renew it.",
          "format": "date-time",
          "type": "string"
        },
        "pickup_search_postcode": {
          "pattern": "^[0-9]{5}$",
          "type": "string"
        },
        "pickup_search_radius_km": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "number"
        },
        "postcode": {
          "$ref": "#/$defs/nullableText"
        },
        "price_basis": {
          "$ref": "#/$defs/nullableText"
        },
        "price_eur": {
          "$ref": "#/$defs/nullableNumber"
        },
        "price_kind": {
          "$ref": "#/$defs/nullableText"
        },
        "product_kind": {
          "enum": [
            "apparatus",
            "tool",
            "component",
            "accessory",
            "media",
            "consumable",
            "unknown"
          ]
        },
        "reasons": {
          "items": {
            "maxLength": 600,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "reserve_price_met": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reserve_status": {
          "enum": [
            "none",
            "not_met",
            "met",
            "unknown"
          ]
        },
        "risks": {
          "items": {
            "maxLength": 600,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "scalp_score": {
          "$ref": "#/$defs/nullableScore",
          "description": "Semantic economic-interest factor, not a price appraisal; version 1 preserves a known old overall score only as a legacy cue."
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "score_version": {
          "description": "Per-item assessment version, independent of feed schema 3. Version 1 has no assessed Useability or new Interest.",
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "semantic_assessed": {
          "type": "boolean"
        },
        "semantic_assessed_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "semantic_interest": {
          "$ref": "#/$defs/nullableScore",
          "deprecated": true,
          "description": "Deprecated alias of exported scalp_score, never the derived V2 Interest."
        },
        "semantic_review_mode": {
          "enum": [
            "interactive",
            "api"
          ]
        },
        "shipping_confirmed": {
          "type": "boolean"
        },
        "shipping_eur": {
          "$ref": "#/$defs/nullableNumber"
        },
        "source": {
          "$ref": "#/$defs/nullableText"
        },
        "source_observed_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "source_provider": {
          "$ref": "#/$defs/sourceProvider"
        },
        "source_url": {
          "$ref": "#/$defs/sourceUrl"
        },
        "stale": {
          "type": "boolean"
        },
        "time_window_eligible": {
          "description": "Time-window membership at generation time only; recompute against the current clock.",
          "type": "boolean"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "total_eur": {
          "$ref": "#/$defs/nullableNumber"
        },
        "total_known_eur": {
          "$ref": "#/$defs/nullableNumber"
        },
        "url": {
          "$ref": "#/$defs/nullableText"
        },
        "useability_reason": {
          "maxLength": 500,
          "type": "string"
        },
        "useability_score": {
          "$ref": "#/$defs/nullableScore",
          "description": "Practical independence from additional equipment, software, accessories or infrastructure; not probability of working condition. Null means not assessed."
        },
        "valid_until": {
          "description": "V3 equals ends_at; not a current-price/bid guarantee. Recheck auction end and active time window when reading.",
          "format": "date-time",
          "type": "string"
        },
        "value_band": {
          "enum": [
            "around_5",
            "around_50",
            "around_500",
            "unknown"
          ]
        },
        "value_reason": {
          "$ref": "#/$defs/nullableText"
        },
        "verification_level": {
          "$ref": "#/$defs/verificationLevel"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "description_truncated",
        "description_status",
        "price_eur",
        "shipping_eur",
        "bid_count",
        "distance_km",
        "ends_at",
        "last_seen_at",
        "content_updated_at",
        "valid_until",
        "detail_path",
        "eligibility",
        "time_window_eligible",
        "reserve_status",
        "score",
        "interest_score",
        "value_band",
        "assessment_confidence",
        "assessment_basis",
        "semantic_assessed",
        "reasons",
        "risks"
      ],
      "type": "object"
    },
    "itemDocument": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "properties": {
            "item": {
              "$ref": "#/$defs/item"
            },
            "kind": {
              "const": "item"
            }
          },
          "required": [
            "item"
          ],
          "type": "object"
        }
      ]
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "properties": {
            "assessment": {
              "properties": {
                "condition_verified": {
                  "const": false
                },
                "interest_formula": {
                  "const": "round_half_up(scalp_score * useability_score / 100)"
                },
                "is_appraisal": {
                  "const": false
                },
                "must_recheck_original_before_bidding": {
                  "const": true
                },
                "purpose": {
                  "const": "personal_attention_priority"
                },
                "score_version": {
                  "const": 2
                },
                "useability_focus": {
                  "const": "dependencies_and_practical_independence"
                },
                "useability_is_condition_probability": {
                  "const": false
                }
              },
              "required": [
                "purpose",
                "is_appraisal",
                "condition_verified",
                "must_recheck_original_before_bidding"
              ],
              "type": "object"
            },
            "counts": {
              "properties": {
                "page_size": {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                "pages": {
                  "minimum": 1,
                  "type": "integer"
                },
